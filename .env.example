VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Where the /catering form POSTs its JSON. Optional — while it is unset the form
# falls back to opening the visitor's mail client. Anything that accepts a JSON
# POST works (Zapier/Make/n8n catch hook, Supabase Edge Function, Formspree).
# NOTE: this ships in the client bundle and is public — anyone can POST to it.
VITE_CATERING_WEBHOOK_URL=
