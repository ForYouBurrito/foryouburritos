VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# ---------------------------------------------------------------------------
# Form delivery — one n8n webhook per form, each appending to its own sheet.
#
# These are the SECOND destination. Every submission is also inserted into
# Supabase (contact_submissions / catering_submissions) and shown at
# /admin/forms, and the two sends are independent: either one landing counts as
# delivered, and only if both fail does the form hand off to `mailto:`. So the
# site works with these unset — it just has no spreadsheet.
#
# Use the PRODUCTION url from each n8n Webhook node (.../webhook/...), not the
# test one (.../webhook-test/...), and activate the workflow or it 404s.
# Setup, including the CORS setting that trips everyone up: docs/n8n-forms.md
#
# NOTE: these ship in the client bundle and are public — anyone can POST to
# them. Keep the paths unguessable and rate-limit on the n8n side.
# ---------------------------------------------------------------------------
VITE_CONTACT_WEBHOOK_URL=
VITE_CATERING_WEBHOOK_URL=
